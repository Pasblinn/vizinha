# yoosee-nvr configuration
#
#   cp .env.example .env && chmod 600 .env
#
# .env is gitignored. Never commit real credentials.
# Values below are defaults unless marked REQUIRED.

# ============================================================
# CAMERA (REQUIRED)
# ============================================================
# The camera's address on your LAN. Give it a DHCP reservation so it does not
# move; a changing IP is the most common cause of "it stopped recording".
CAMERA_IP=192.168.1.50

# Credentials set in the Yoosee mobile app. Many of these cameras ship with a
# blank or trivial password - change it in the app before exposing anything.
CAMERA_USER=admin
CAMERA_PASS=change-me

CAMERA_PORT=554
# RTSP path. /onvif1 is the main stream on HWN-AP03; /onvif2 is usually the
# lower-resolution substream. Run `python3 rtsp_probe.py --describe` if unsure.
CAMERA_PATH=/onvif1

# Local proxy that rewrites the camera's malformed Transport header.
PROXY_HOST=127.0.0.1
PROXY_PORT=8554

# ============================================================
# RECORDING
# ============================================================
# Where footage is written. Relative paths resolve against the project folder.
RECORDING_DIR=recordings

# Seconds per file. Shorter segments upload sooner and lose less on a crash;
# longer segments mean fewer files. 600 = 10 minutes.
SEGMENT_DURATION=600
CONTAINER_FORMAT=mp4

# Recording window, 24h clock. Start > end crosses midnight (21 -> 7 is night).
# Set both to the same value to record around the clock.
RECORDING_START_HOUR=21
RECORDING_END_HOUR=7

# Timezone for the recording window and filenames.
TZ=America/Sao_Paulo

# ============================================================
# CLOUD BACKUP
# ============================================================
CLOUD_ENABLED=true

# Name of the rclone remote (`rclone config` creates it, `rclone listremotes`
# lists it). Any rclone backend works: Drive, S3, Backblaze, Dropbox, SFTP.
RCLONE_REMOTE=gdrive
CLOUD_FOLDER_NAME=yoosee-nvr

CLOUD_UPLOAD_INTERVAL=60
CLOUD_UPLOAD_TIMEOUT=300

# Delete the local copy once a segment is safely uploaded. Turn this on when
# the local disk is small and the cloud is the real archive.
CLOUD_DELETE_LOCAL_AFTER_UPLOAD=false

# ============================================================
# LOCAL STORAGE ROTATION
# ============================================================
MAX_STORAGE_GB=50
MIN_FREE_DISK_GB=5
RETENTION_DAYS=7
CLEANUP_INTERVAL=3600

# ============================================================
# SOUND LEVEL METER
# ============================================================
DECIBEL_SAMPLE_RATE=16000
DECIBEL_INTERVAL=1.0
DECIBEL_ALERT_THRESHOLD=85
DECIBEL_HISTORY_SIZE=3600

# Cheap camera microphones read high. Adjust until a quiet room reads roughly
# 30-40 dB. Readings are estimates, not calibrated SPL measurements.
DECIBEL_MIC_OFFSET=-25
DECIBEL_LOG_FILE=decibels.log

# ============================================================
# WEB DASHBOARD
# ============================================================
# 127.0.0.1 keeps the dashboard on the machine itself (reach it over SSH or a
# VPN). Use 0.0.0.0 only behind the firewall rules in scripts/harden.sh.
WEB_HOST=127.0.0.1
WEB_PORT=9847

DASHBOARD_USER=admin

# Preferred: a PBKDF2 hash from `python3 scripts/hash_password.py`.
# DASHBOARD_PASS_HASH=pbkdf2_sha256$260000$...$...
#
# Or a plaintext password (REQUIRED if no hash is set):
DASHBOARD_PASS=change-me

SESSION_TIMEOUT=3600
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=900

# TLS certificates. scripts/harden.sh generates a self-signed pair here; when
# both server.crt and server.key exist, the dashboard serves HTTPS.
CERT_DIR=certs

# Leave unset to generate and persist a key in .flask_secret_key automatically.
# FLASK_SECRET_KEY=

# ============================================================
# LOGGING
# ============================================================
LOG_FILE=yoosee-nvr.log
LOG_LEVEL=INFO
